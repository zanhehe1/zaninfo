def ping_bot():
    while True:
        try:
            resp = requests.get(f"{BOT_URL}/check", timeout=10)
            print(f"[{time.strftime('%H:%M:%S')}] ✅ Bot online: {resp.status_code}")
        except Exception as e:
            print(f"[{time.strftime('%H:%M:%S')}] ❌ Bot offline: {e}")
        time.sleep(300)

