# ====== ROUTE ======
@app.route('/')
def index():
    return render_template_string(HTML)

@app.route('/upload', methods=['POST'])
def upload_files():
    try:
        files = request.files.getlist('files')
        saved = []
        for f in files:
            if f.filename:
                path = os.path.join('/tmp', f.filename)
                f.save(path)
                saved.append(f.filename)
        return jsonify({"success": True, "count": len(saved), "files": saved})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)})

@app.route('/files')
def list_files():
    try:
        files = []
        for f in os.listdir('/tmp'):
            if os.path.isfile(os.path.join('/tmp', f)):
                files.append({"name": f, "size": os.path.getsize(os.path.join('/tmp', f))})
        return jsonify({"files": files})
    except Exception as e:
        return jsonify({"files": [], "error": str(e)})

@app.route('/start', methods=['POST'])
def start_bot():
    try:
        # Chạy bot.py nếu có
        import subprocess
        subprocess.Popen(['python3', '/tmp/start.py'], cwd='/tmp')
        return jsonify({"success": True})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)})

@app.route('/stop', methods=['POST'])
def stop_bot():
    try:
        import subprocess
        subprocess.Popen(['pkill', '-f', 'start.py'])
        return jsonify({"success": True})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)})

@app.route('/ping')
def ping_now():
    try:
        resp = requests.get(f"{BOT_URL}/check", timeout=10)
        return jsonify({"success": True, "status": resp.status_code})
    except Exception as e:
        return jsonify({"success": False, "error": str(e)})

if __name__ == '__main__':
